# Documentation template only. The shared application owns environment loading.
# Do not copy development settings onto a production connection.
NODE_ENV=development
KNOWLEDGE_EMBEDDING_PROVIDER=transformers-local
KNOWLEDGE_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
KNOWLEDGE_EMBEDDING_DIMENSIONS=384
# Relative to the backend working directory when explicitly set.
KNOWLEDGE_EMBEDDING_CACHE_DIR=.cache/aegisops-models
KNOWLEDGE_VECTOR_INDEX=knowledge_vector_index
# atlas | local-vector | keyword
KNOWLEDGE_SEARCH_BACKEND=atlas
# local-vector | keyword | none
KNOWLEDGE_SEARCH_FALLBACK=local-vector
