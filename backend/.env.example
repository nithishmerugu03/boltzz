# Express backend (monitoring routes + War Room gateway)
PORT=5000
# Optional for monitoring persistence (backend/src/config/db.js)
MONGODB_URI=
AI_WORKFLOW_URL=http://127.0.0.1:8000

# RCA & security agent
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=15000
SECURITY_FAILED_LOGIN_THRESHOLD=5
SECURITY_AUTH_SPIKE_THRESHOLD=20
SECURITY_EVENT_WINDOW_MS=300000
