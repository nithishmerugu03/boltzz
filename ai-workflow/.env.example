# mock = local fixtures for unfinished teammate modules; real = call connected modules
MODULE_MODE=mock
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=aegisops
# Communication LLM (never commit real keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# none = fail communication if LLM unavailable; template = clearly-labelled deterministic text built from state
COMMUNICATION_FALLBACK=none
# REAL mode endpoints for teammate modules (HTTP POST, return common JSON contract)
LOG_ANALYSIS_URL=
RCA_SECURITY_ANALYSIS_URL=
KNOWLEDGE_RETRIEVAL_URL=
REMEDIATION_URL=
# Optional: in mock mode, force these components to fail (comma separated) for demos
MOCK_FAIL_COMPONENTS=
